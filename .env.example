# Docelowy adres aplikacji pod subdomeną (WYMAGANY konkretny origin w produkcji; '*' jest zabronione)
CORS_ORIGIN=https://quiz.twojadomena.pl

# Konfiguracja bazy PostgreSQL (konta administratorów, quizy, logi audytowe)
POSTGRES_DB=cyber_quiz
POSTGRES_USER=cyber_quiz
POSTGRES_PASSWORD=zmien-mnie-na-dlugie-losowe-haslo

# Ciasteczka sesyjne i timeouty (w sekundach)
COOKIE_SECURE=true
SESSION_IDLE_TTL_ADMIN=3600
SESSION_IDLE_TTL_SUPERADMIN=1800
SESSION_ABSOLUTE_TTL=28800

# Nazwa istniejącej sieci Dockera, w której działa kontener SWAG.
# Sprawdź na serwerze poleceniem:
#   docker inspect swag --format '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}'
SWAG_NETWORK=swag
