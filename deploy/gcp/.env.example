# ==============================================================================
# Konfiguracja środowiska aplikacji Cyber Quiz dla GCP (docker-compose.gcp.yml)
# Skopiuj do katalogu głównego repozytorium na VM jako .env:
#   cp deploy/gcp/.env.example .env && chmod 600 .env
# ==============================================================================

# Subdomena dla Caddy (automatyczny certyfikat HTTPS Let's Encrypt)
APP_DOMAIN=quiz.twojadomena.pl

# E-mail do powiadomień Let's Encrypt (wygasanie certyfikatów itp.)
ACME_EMAIL=admin@twojadomena.pl

# Docelowy origin aplikacji (WYMAGANY konkretny adres HTTPS; '*' jest zabronione)
CORS_ORIGIN=https://quiz.twojadomena.pl

# Konfiguracja WebAuthn / FIDO2 MFA (musi pasować do APP_DOMAIN / CORS_ORIGIN)
WEBAUTHN_RP_NAME=Cyber Quiz
WEBAUTHN_RP_ID=quiz.twojadomena.pl
WEBAUTHN_ORIGIN=https://quiz.twojadomena.pl
SUPERADMIN_MFA_ENFORCEMENT=required
WEBAUTHN_USER_VERIFICATION=required

# Baza PostgreSQL (wygeneruj hasło: openssl rand -base64 32)
POSTGRES_DB=cyber_quiz
POSTGRES_USER=cyber_quiz
POSTGRES_PASSWORD=zmien-mnie-na-dlugie-losowe-haslo

# Ciasteczka sesyjne i timeouty (w sekundach)
COOKIE_SECURE=true
SESSION_IDLE_TTL_ADMIN=3600
SESSION_IDLE_TTL_SUPERADMIN=1800
SESSION_ABSOLUTE_TTL=28800

