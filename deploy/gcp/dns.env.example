# ==============================================================================
# Konfiguracja automatycznej aktualizacji rekordu A przy starcie VM (Wariant B)
# Skopiuj na VM jako /etc/cyber-quiz/dns.env (uprawnienia: chmod 600):
#   sudo install -d -m 700 /etc/cyber-quiz
#   sudo cp /opt/cyber-quiz/deploy/gcp/dns.env.example /etc/cyber-quiz/dns.env
#   sudo chmod 600 /etc/cyber-quiz/dns.env
# ==============================================================================

# Wybierz dostawcę: cloudflare | custom_webhook
DNS_PROVIDER=cloudflare

# --- Opcja 1: Cloudflare (ZALECANA — darmowy DNS, szybka propagacja, TTL=60) ---
# Token API utwórz w: Cloudflare Dashboard -> My Profile -> API Tokens
# Uprawnienia (minimalne): Zone -> DNS -> Edit (tylko dla wybranej strefy)
CF_API_TOKEN=wklej-token-api-cloudflare
CF_ZONE_ID=wklej-zone-id-domeny
CF_RECORD_NAME=quiz.twojadomena.pl
CF_TTL=60
# Musi być false (DNS only), aby Caddy mógł wystawić certyfikat TLS i obsługiwać WebSockety bezpośrednio
CF_PROXIED=false

# --- Opcja 2: Dowolny inny dostawca DNS (DynHost OVH, Namecheap, DuckDNS, własny webhook) ---
# Wstaw {IP} w miejscu, gdzie skrypt ma podstawić aktualny adres IPv4 VM.
# Przykłady:
#   OVH DynHost:   https://www.ovh.com/nic/update?system=dyndns&hostname=quiz.twojadomena.pl&myip={IP}
#   DuckDNS:       https://www.duckdns.org/update?domains=mojquiz&token=TWOJ_TOKEN&ip={IP}
#   Custom API:    https://api.twojdostawca.pl/dns/update?host=quiz&ip={IP}
CUSTOM_WEBHOOK_URL=
# Opcjonalna metoda HTTP (domyślnie GET)
CUSTOM_WEBHOOK_METHOD=GET
# Opcjonalna autoryzacja Basic Auth (np. "user:pass" dla OVH DynHost)
CUSTOM_WEBHOOK_AUTH=
# Opcjonalny nagłówek (np. "Authorization: Bearer TWOJ_TOKEN")
CUSTOM_WEBHOOK_HEADER=

